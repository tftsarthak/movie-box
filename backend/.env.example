# config
PORT=3000
NODE_ENV=development

# run locally - frontend,backend individually
# CORS_ORIGIN=http://localhost:5173
# APP_URL=http://localhost:3000
# CLIENT_URL=http://localhost:5173

# run locally using docker image (monolithic dev run)-
CORS_ORIGIN=http://localhost:80
APP_URL=http://localhost:80
CLIENT_URL=http://localhost:80

# for deploy to ec2, change to domain -
# Production URLs (Point to your domain)
# CORS_ORIGIN=//ankajgoyal.com
# APP_URL=//ankajgoyal.com
# CLIENT_URL=//ankajgoyal.com

# Database
MONGODB_URI=

# Authentication & JWT
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External APIs
GROQ_API_KEY=
TMDB_ACCESS_TOKEN=

# Cognito Backend Config
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_AUTHORITY=
